module cruise_speed_management

    % Controller States Enumeration
    type ControlState;
    constant OFF: ControlState;
    constant ON: ControlState;
    constant STDBY: ControlState;
    constant DISABLE: ControlState;

    %Inputs
    input CruiseState : ControlState;
    input current_speed : float;
    input On;
    input Set;
    input QuickAccel;
    input QuickDecel;

    %Outputs
    output CruiseSpeed : float;

    %Constants
    constant SpeedMin = 30f : float;
    constant SpeedMax = 150f : float;
    constant SpeedInc = 10f : float;

    var speed : float in
        loop
            abort 
                speed := current_speed;
                pause;
            when immediate On;

            present QuickAccel then
                speed := speed + SpeedInc;
                emit CruiseSpeed(?speed);
                pause;
            else
                present QuickDecel then
                    speed := speed - SpeedInc;
                    emit CruiseSpeed(?speed);
                    pause;
                else
                    present Set then
                        speed := current_speed;
                        emit CruiseSpeed(?speed);
                        pause;
                    end present;
                end present;
            end present;

        end loop;
    end var;


end module
